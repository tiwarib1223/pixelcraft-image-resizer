<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PixelCraft" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <!-- v0.20.3: the pre-Compose window already shows the opening video's first frame - no black frame. -->
        <item name="android:windowBackground">@drawable/opening_bg</item>
        <item name="android:statusBarColor">#FFFFFF</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:colorAccent">#42BFEF</item>
    </style>

    <!-- v0.20.2 (his request #2, after watching the build on his phone): NO icon on the launch splash - the dim
         logo flash before the video looked muddy. Clean starry navy only, then his 5s video flows in. -->
    <style name="Theme.PixelCraft.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#030B1E</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_transparent</item>
        <item name="postSplashScreenTheme">@style/Theme.PixelCraft</item>
    </style>
</resources>
